{
  "name": "toy",
  "scopeName": "source.toy",
  "filetypes": ["ty"],
  "patterns": [
    { "match": "\\b(let|in)\\b", "name": "keyword.control.toy" },
    { "include": "#strings" },
    { "match": "--.*$", "name": "comment.line.toy", "captures": { "0": "punctuation.ignored.toy" } }
  ],
  "repository": {
    "strings": [
      { "match": "\"[^\"]*\"", "name": "string.quoted.double.toy" }
    ]
  }
}
